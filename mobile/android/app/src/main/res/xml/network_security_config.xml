<?xml version="1.0" encoding="utf-8"?>
<!--
  Allows HTTP cleartext traffic to 10.0.2.2 (Android emulator → host localhost)
  for local development only. Production builds should use HTTPS exclusively.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
