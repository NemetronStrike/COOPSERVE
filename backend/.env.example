# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ── Application ───────────────────────────────────────────────────────────────
APP_ENV=development
APP_DEBUG=true
APP_HOST=127.0.0.1
APP_PORT=8000

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins for local Flutter development.
CORS_ORIGINS=http://localhost,http://127.0.0.1,http://10.0.2.2

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/coopserve

# -----------------------------------------------------------------------------
# Security & Authentication
# -----------------------------------------------------------------------------
# JWT secret key for signing authentication tokens
SECRET_KEY=change_this_to_a_secure_random_string_in_production

# -----------------------------------------------------------------------------
# AI Integration
# -----------------------------------------------------------------------------
# Google Gemini API key for AI features (e.g., service search, worker matching)
# Get one at: https://aistudio.google.com/
# GEMINI_API_KEY=your_gemini_api_key_here
# ACCESS_TOKEN_EXPIRE_MINUTES=1440
