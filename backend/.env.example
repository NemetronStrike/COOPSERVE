# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ── Application ───────────────────────────────────────────────────────────────
APP_ENV=development
APP_DEBUG=true
APP_HOST=127.0.0.1
APP_PORT=8000

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins for local Flutter development.
CORS_ORIGINS=http://localhost,http://127.0.0.1,http://10.0.2.2

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/coopserve

# ── Security (not yet implemented) ────────────────────────────────────────────
# SECRET_KEY=change-me-to-a-long-random-string
# ACCESS_TOKEN_EXPIRE_MINUTES=30
